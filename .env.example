# Public site origin used by Canonical, OpenGraph, JSON-LD, Sitemap, robots, and RSS.
# Current production (until the approved domain activation): https://judao.club
# Domain activation target: https://xintuozhiwuye.com
# Local development: http://localhost:3000
# Vercel Preview may leave this unset to use VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://judao.club

# Required for production builds and runtime. Use secret environment variables in Vercel.
# Do not commit real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Closed by default. Enable only when the writable runtime/storage design is approved.
KNOWLEDGE_WRITES_ENABLED=false

# Cooperation module. Staging uses `supabase`; the domestic Production Candidate uses `oidc`.
COOPERATION_DATABASE_URL=
COOPERATION_DATABASE_HOST=
COOPERATION_DATABASE_PORT=5432
COOPERATION_DATABASE_NAME=
COOPERATION_DATABASE_USER=
COOPERATION_DATABASE_PASSWORD=
COOPERATION_DATABASE_POOL_SIZE=5
COOPERATION_DATABASE_SSL=require
COOPERATION_DATABASE_CA_CERT_FILE=
COOPERATION_DATABASE_CA_CERT=
COOPERATION_IDENTITY_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Domestic OIDC / Alibaba Cloud IDaaS candidate values. Never commit real values.
COOPERATION_OIDC_ISSUER=
COOPERATION_OIDC_CLIENT_ID=
COOPERATION_OIDC_CLIENT_SECRET=
COOPERATION_OIDC_AUTHORIZATION_ENDPOINT=
COOPERATION_OIDC_TOKEN_ENDPOINT=
COOPERATION_OIDC_JWKS_URI=
COOPERATION_OIDC_REDIRECT_URI=
COOPERATION_OIDC_MFA_ACR_VALUES=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
